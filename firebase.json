{
  "hosting": [
    {
      "target": "scoutnadi",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "ppmdaftar",
      "public": "redirect",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "**",
          "destination": "https://scoutnadi.web.app/:1",
          "type": 301
        }
      ]
    }
  ]
}
